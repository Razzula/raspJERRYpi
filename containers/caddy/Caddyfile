# Caddy
vault.razzula.uk:984 {
    tls {
        dns cloudflare {env.CLOUDFLARE_TOKEN}
    }

    @config {
        path /config /config/
        method GET HEAD
    }

    handle @config {
        reverse_proxy caddy:784 {
            header_up Origin https://vault.razzula.uk:984
        }
    }

    respond 403
}

